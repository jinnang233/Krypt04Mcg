{
  "enableDataApi": false,
  "apiChannelCount": 16,
  "apiReceiver": "",
  "enableFileSending": false,
  "enableFileReceiving": false,
  "permanentlyDisableFileSharing": false,
  "showProgress": true,
  "showSentPlaintext": true,
  "hideEncryptedRawMessage": true,
  "verboseMessages": false,
  "enableCompression": true,
  "showReceiveProgress": true,
  "enableConversationHistory": false,
  "showDisclaimerWarning": true,
  "fragmentSize": 180,
  "sendDelayMs": 250,
  "sessionTtlMinutes": 60,
  "maxPacketAgeSeconds": 300,
  "maxFutureSkewSeconds": 60,
  "maxMessagesPerSession": 100,
  "rotateAfterBytes": 1048576,
  "chatSendMode": "CHAT",
  "serverCommandTemplate": "/msg <receiver> <fragment>",
  "messagePrefix": "[Krypt04Mcg]",
  "packetPrefix": "[KRYPT04MCG]",
  "receiveRegexMode": false,
  "receiveRegex": "^\\[KRYPT04MCG\\] .+",
  "shadowListenMode": false,
  "shadowListenRegexes": [
    "^<(?<player>[^>]+)>\\s*(?<message>.*)$"
  ],
  "shadowListenRegex": "^<(?<player>[^>]+)>\\s*(?<message>.*)$",
  "kemAlgorithm": "ML-KEM-768+X25519",
  "ephemeralKemAlgorithm": "ML-KEM-768+X25519",
  "signatureAlgorithm": "SLH-DSA-SHA2-192S",
  "aeadAlgorithm": "AES-256-GCM"
}
